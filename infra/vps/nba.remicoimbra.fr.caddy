# Bloc de site NBA Predictor, ajouté à la fin de /etc/caddy/Caddyfile
# (voir docs/deploiement.md). Ce fichier n'est qu'une copie de référence :
# le Caddyfile du VPS contient aussi d'autres sites.

nba.remicoimbra.fr {
	# Site en lecture seule : aucun envoi légitime n'a de corps.
	request_body {
		max_size 16KB
	}

	header {
		# Sans includeSubDomains : ne concerne que ce nom.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# 'unsafe-inline' : scripts inline de l'export Next (données RSC, thème
		# anti-flash) et styles inline des animations. Pas de contenu saisi par
		# les visiteurs ni de cookie sur ce site.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	encode zstd gzip

	# API FastAPI (service systemd nba-predictor-api), préfixe /api retiré.
	handle_path /api/* {
		reverse_proxy 127.0.0.4:8000 {
			transport http {
				# Adresse source attendue par le filtre IP du service.
				local_address 127.0.0.5
			}
		}
	}

	# Front : export statique Next.js (front/out/), version courante.
	handle {
		root * /var/www/nba-predictor/current
		@hashed path /_next/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Next 16 écrit modele/__next.modele/__PAGE__.txt mais le navigateur
		# précharge modele/__next.modele.__PAGE__.txt : sans cette règle, 404
		# puis requête de repli. « not file » : sans effet si Next corrige.
		@segment {
			path_regexp segment ^/([^/]+)/__next\.([^/]+)\.__PAGE__\.txt$
			not file
		}
		rewrite @segment /{re.segment.1}/__next.{re.segment.2}/__PAGE__.txt
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		root * /var/www/nba-predictor/current
		rewrite * /404.html
		file_server
	}
}
